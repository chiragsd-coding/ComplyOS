# Copy to .env and fill in values (see README.md for details).
# Bun auto-loads this file; never commit real secrets.

# Required — Neon serverless Postgres connection string.
# Get it from https://console.neon.tech → your project → Connection Details.
# Use the pooled connection string; it looks like:
# postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
